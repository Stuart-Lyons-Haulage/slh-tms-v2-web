# Copy to .env.standalone and keep it OUT of Git.
SQL_SA_PASSWORD=CHANGE_ME_STRONG_SQL_PASSWORD
SQL_EDITION=Express
TMS_JWT_SIGNING_KEY=CHANGE_ME_RANDOM_MINIMUM_32_CHARACTERS
TMS_BOOTSTRAP_USERNAME=admin
TMS_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
TMS_BOOTSTRAP_DISPLAY_NAME=SLH Administrator
TMS_HTTP_PORT=8080
SQL_BACKUP_HOST_PATH=../../backup

# Mount the actual SLH server archive share on the Docker host and point this at that mount.
ARCHIVE_ENABLED=false
ARCHIVE_HOST_PATH=../../archive
ARCHIVE_OUTBOX_DAYS=7
ARCHIVE_TELEMETRY_DAYS=90
ARCHIVE_GEOFENCE_DAYS=180
ARCHIVE_ETA_DAYS=90
ARCHIVE_SYNC_DAYS=30

ROADTECH_ENABLED=false
ROADTECH_BASE_URL=
ROADTECH_API_KEY=
ROADTECH_USERNAME=
ROADTECH_PASSWORD=
ROADTECH_COMPANY_CODE=

TACHOMASTER_ENABLED=false
TACHOMASTER_BASE_URL=
TACHOMASTER_API_KEY=
TACHOMASTER_USERNAME=
TACHOMASTER_PASSWORD=

SAGEHR_ENABLED=false
SAGEHR_BASE_URL=
SAGEHR_API_KEY=

FLEETIO_ENABLED=false
FLEETIO_BASE_URL=https://secure.fleetio.com/api/v1
FLEETIO_API_KEY=
FLEETIO_ACCOUNT_TOKEN=
